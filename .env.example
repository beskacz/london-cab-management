# Copy to .env and adjust (optional). Used by docker compose.
# Web UI: http://127.0.0.1:${GIBBON_HTTP_PORT} (see README "Docker + Portless" for https://gibbon.localhost)
GIBBON_HTTP_PORT=8080
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=gibbon_root
MYSQL_DATABASE=gibbon
MYSQL_USER=gibbon
MYSQL_PASSWORD=gibbon
